# Gradle / AGP
.gradle/
build/
app/build/
local.properties
captures/
.kotlin/

# 隔离用的 GRADLE_USER_HOME（README 的构建命令会用到）
.gradle-home/

# 真机调试产物：帧序列、录屏、拉下来的 framework-res.apk 很大，不入库
build-artifacts/

# 分发目录：`tools/publish-apk.cjs` 生成（APK + latest.json + 下载页）。
# APK 是构建产物，二进制不入库；但 `latest.json` 的版本号信息要能追溯，
# 那个记在 `version.properties` 里（已跟踪）。
dist/

# 调试截图与控件树快照：一次性排查产物，不入库。
# 曾在仓库根目录误提交 25 个 shot-*.png + ui.xml，占 .git 的 95%（62.7 MB / 66.1 MB），
# 已用 `git rm --cached` 取消跟踪并把文件移到 build-artifacts/shots/（本地保留）。
# 需要长期留存的证据图放 docs/evidence/，不要放根目录。
shot-*.png
shot-*.jpg
ui.xml

